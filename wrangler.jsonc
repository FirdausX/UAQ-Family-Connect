{
    "name":  "uaq-family-connect",
    "compatibility_date":  "2026-10-10",
    "route":  {
                  "zone_name":  "uaqelderlycarecentre.com",
                  "pattern":  "family.uaqelderlycarecentre.com/*"
              },
    "keep_vars":  true,
    "assets":  {
                   "not_found_handling":  "single-page-application",
                   "directory":  "./dist"
               },
    "workers_dev":  true
}